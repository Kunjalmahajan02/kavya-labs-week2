// Tables live in the "kavya" Postgres schema (see lib/dbUrl.js), created by scripts/db-push.js on each build.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per person who has signed in with Google
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  image       String?
  role        String   @default("user") // "user" | "admin" (admins come from ADMIN_EMAILS)
  loginCount  Int      @default(0)
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
}
