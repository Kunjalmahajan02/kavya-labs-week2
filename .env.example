# ---- NextAuth ----
# Your site's URL: http://localhost:3000 locally, https://<your-app>.vercel.app in production
NEXTAUTH_URL="http://localhost:3000"
# Any long random string
NEXTAUTH_SECRET=""

# ---- Google OAuth ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that get the admin role (used by the Week 3 admin dashboard)
ADMIN_EMAILS=""

# ---- Database (Supabase) ----
# Same values as your other projects; tables go into a separate "kavya" schema automatically
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
